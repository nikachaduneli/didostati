# Copy to .env and change for production. docker compose reads it automatically.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is opened on another address, e.g. https://didostati.ge
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=didostati
POSTGRES_USER=didostati
POSTGRES_PASSWORD=didostati
HTTP_PORT=8000
# Host ports for Postgres and Redis (change if already used on this machine)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
